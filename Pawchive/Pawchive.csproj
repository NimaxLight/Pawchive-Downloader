<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PawchiveDownloader</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.8.0</Version>
    <ApplicationIcon>Assets/paw.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="SharpCompress" Version="0.50.8" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/paw.ico" LogicalName="Pawchive.Brand.ico" />
    <EmbeddedResource Include="Assets/paw.png" LogicalName="Pawchive.Brand.png" />
    <EmbeddedResource Include="Locales/en.json" LogicalName="Pawchive.Strings.en.json" />
  </ItemGroup>
</Project>
